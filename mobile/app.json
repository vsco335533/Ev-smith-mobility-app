{
  "expo": {
    "name": "EVSMITH Mobility",
    "slug": "evsmith-mobility",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "evsmith",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080C0E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.evsmith.mobility"
    },
    "android": {
      "package": "com.evsmith.mobility",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080C0E"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload KYC documents."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "afb329fd-69a2-4c65-a611-a3391c60bc9d"
      }
    }
  }
}
