# ==========================================
# EVSMITH MOBILITY SERVICES - CONFIGURATION
# ==========================================

# Application
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8081

# Database
# Default: SQLite for zero-setup local dev. For PostgreSQL: postgresql://postgres:postgres@localhost:5432/evsmith_db
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/evsmith_db

# JWT Authentication
JWT_SECRET_KEY=generate_a_secure_jwt_secret_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Bravo / Brevo Email OTP Service
BRAVO_API_KEY=your_brevo_api_key_here
BRAVO_API_URL=https://api.brevo.com/v3/smtp/email
BRAVO_EMAIL_TEMPLATE_ID=3

# In development without Bravo keys, OTP is safely logged to console for testing

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=evsmith_documents

# Super Admin Seed Account
SUPER_ADMIN_EMAIL=admin@evsmith.com
SUPER_ADMIN_PHONE=9876543210
SUPER_ADMIN_PASSWORD=Admin@EVSmith2026!
